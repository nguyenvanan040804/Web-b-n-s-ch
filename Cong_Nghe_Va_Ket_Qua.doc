<title>Công Nghệ Sử Dụng & Kết Quả Đạt Được</title>
<style>
  body { font-family: 'Times New Roman', Times, serif; font-size: 14pt; line-height: 1.6; }
  h1 { text-align: center; color: #1e3a8a; font-size: 20pt; text-transform: uppercase; margin-bottom: 24px; }
  h2 { color: #2563eb; font-size: 16pt; margin-top: 24px; border-bottom: 2px solid #ddd; padding-bottom: 4px; }
  h3 { color: #333; font-size: 15pt; margin-top: 16px; margin-bottom: 8px; }
  ul { margin-top: 8px; margin-bottom: 16px; }
  li { margin-bottom: 8px; }
